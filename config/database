<?php

class Database
{
    private $host = "localhost";
    private $user = "root";
    private $password = "";
    private $database = "bus_tracking_system";

    public $conn;

    public function connect()
    {
        $this->conn = mysqli_connect(
            $this->host,
            $this->user,
            $this->password,
            $this->database
        );

        if (!$this->conn) {
            die("Database Connection Failed: " . mysqli_connect_error());
        }

        return $this->conn;
    }
}
