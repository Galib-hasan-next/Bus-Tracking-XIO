/* ==========================================
GENERAL
========================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{

    background:#f4f7fc;

    color:#333;

}

.container{

    width:95%;

    max-width:1500px;

    margin:30px auto;

}

/* ==========================================
TOPBAR
========================================== */

.topbar{

    background:#fff;

    padding:25px 35px;

    border-radius:18px;

    display:flex;

    justify-content:space-between;

    align-items:center;

    box-shadow:0 5px 18px rgba(0,0,0,.08);

    margin-bottom:25px;

}

.topbar h1{

    color:#0b2b6d;

    margin-bottom:8px;

}

.topbar p{

    color:#666;

}

/* ==========================================
BUTTON
========================================== */

.btn{

    background:#1d5eff;

    color:#fff;

    text-decoration:none;

    padding:12px 22px;

    border-radius:10px;

    transition:.3s;

    font-weight:bold;

}

.btn:hover{

    background:#0b45d1;

}

/* ==========================================
SUMMARY
========================================== */

.summary{

    margin-bottom:25px;

}

.summary-card{

    background:#fff;

    border-radius:18px;

    padding:25px;

    box-shadow:0 5px 18px rgba(0,0,0,.08);

    width:260px;

}

.summary-card h3{

    color:#666;

    margin-bottom:10px;

}

.summary-card h2{

    color:#1d5eff;

    font-size:42px;

}

/* ==========================================
TABLE
========================================== */

.table-box{

    background:#fff;

    border-radius:18px;

    padding:30px;

    box-shadow:0 5px 18px rgba(0,0,0,.08);

}

.table-box h2{

    color:#0b2b6d;

    margin-bottom:20px;

}

table{

    width:100%;

    border-collapse:collapse;

}

table th{

    background:#0b2b6d;

    color:white;

    padding:15px;

    text-align:left;

}

table td{

    padding:15px;

    border-bottom:1px solid #eee;

}

table tr:nth-child(even){

    background:#fafafa;

}

table tr:hover{

    background:#eef5ff;

}

/* ==========================================
STATUS
========================================== */

.paid{

    color:green;

    font-weight:bold;

}

.pending{

    color:#d68b00;

    font-weight:bold;

}

.confirmed{

    color:#0066cc;

    font-weight:bold;

}

.cancelled{

    color:red;

    font-weight:bold;

}

/* ==========================================
VIEW BUTTON
========================================== */

.view-btn{

    background:#1d5eff;

    color:white;

    text-decoration:none;

    padding:8px 15px;

    border-radius:8px;

    font-size:14px;

    transition:.3s;

}

.view-btn:hover{

    background:#0b45d1;

}

/* ==========================================
RESPONSIVE
========================================== */

@media(max-width:1000px){

.topbar{

    flex-direction:column;

    align-items:flex-start;

    gap:15px;

}

.summary-card{

    width:100%;

}

}

@media(max-width:768px){

.container{

    width:98%;

}

.table-box{

    overflow-x:auto;

}

table{

    min-width:1200px;

}

}
