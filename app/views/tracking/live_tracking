<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

// =====================================
// Create Map
// =====================================

var map = L.map('map');

// OpenStreetMap

L.tileLayer(
'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
{
    attribution:'© OpenStreetMap Contributors',
    maxZoom:19
}).addTo(map);

// =====================================
// Bus Icon
// =====================================

var busIcon = L.icon({

    iconUrl:'https://cdn-icons-png.flaticon.com/512/3448/3448339.png',

    iconSize:[45,45],

    iconAnchor:[22,22],

    popupAnchor:[0,-20]

});

// =====================================
// Variables
// =====================================

var marker;

var routeLine;

var routePoints=[];

var currentIndex=0;

var animationSteps=100;

var animationDelay=40;

var currentSpeed=50;

// =====================================
// Load Route Points
// =====================================

fetch("index.php?page=get_route_points&route_id=<?php echo $route_id; ?>")

.then(response=>response.json())

.then(data=>{

    if(data.status=="success"){

        data.points.forEach(function(point){

            routePoints.push({

                stop:point.stop_name,

                lat:parseFloat(point.latitude),

                lng:parseFloat(point.longitude)

            });

        });

        drawRoute();

    }

    else{

        alert("Route not found.");

    }

})

.catch(function(error){

    console.log(error);

});

// =====================================
// Draw Route
// =====================================

function drawRoute(){

    var latlng=[];

    routePoints.forEach(function(point){

        latlng.push([point.lat,point.lng]);

    });

    routeLine=L.polyline(latlng,{

        color:"blue",

        weight:6,

        opacity:.8

    }).addTo(map);

    map.fitBounds(routeLine.getBounds());

    /* Start Marker */

    L.marker(latlng[0]).addTo(map)

    .bindPopup("Start");

    /* Destination Marker */

    L.marker(latlng[latlng.length-1]).addTo(map)

    .bindPopup("Destination");

    /* Bus */

    marker=L.marker(latlng[0],{

        icon:busIcon

    }).addTo(map);

    marker.bindPopup("Bus Started");
        animateBetweenStops();

}

// =====================================
// Distance Calculation (Haversine)
// =====================================

function calculateDistance(lat1,lng1,lat2,lng2){

    var R = 6371;

    var dLat = (lat2-lat1) * Math.PI/180;
    var dLng = (lng2-lng1) * Math.PI/180;

    var a =
        Math.sin(dLat/2) * Math.sin(dLat/2) +
        Math.cos(lat1*Math.PI/180) *
        Math.cos(lat2*Math.PI/180) *
        Math.sin(dLng/2) *
        Math.sin(dLng/2);

    var c = 2 * Math.atan2(Math.sqrt(a),Math.sqrt(1-a));

    return R*c;

}

// =====================================
// Smooth Bus Animation
// =====================================

function animateBetweenStops(){

    if(currentIndex >= routePoints.length-1){

        currentIndex = 0;

    }

    var start = routePoints[currentIndex];

    var end = routePoints[currentIndex+1];

    document.getElementById("currentStop").innerHTML = start.stop;

    document.getElementById("nextStop").innerHTML = end.stop;

    var step = 0;

    function animate(){

        var lat =
            start.lat +
            ((end.lat-start.lat) * step / animationSteps);

        var lng =
            start.lng +
            ((end.lng-start.lng) * step / animationSteps);

        marker.setLatLng([lat,lng]);

        marker.setPopupContent(

            "<b>"+start.stop+" → "+end.stop+"</b><br>" +

            "Speed : "+currentSpeed+" km/h"

        );

        // Speed

        document.getElementById("speed").innerHTML =
        currentSpeed+" km/h";

        // Remaining Distance

        var distance =
        calculateDistance(lat,lng,end.lat,end.lng);

        document.getElementById("distance").innerHTML =
        distance.toFixed(2)+" km";

        // ETA

        var eta =
        (distance/currentSpeed)*60;

        document.getElementById("eta").innerHTML =
        Math.ceil(eta)+" Minutes";

        if(step < animationSteps){

            step++;

            setTimeout(animate,animationDelay);

        }

        else{

            currentIndex++;

            currentSpeed =
            Math.floor(Math.random()*21)+40;

            animateBetweenStops();

        }

    }

    animate();

}

</script>

