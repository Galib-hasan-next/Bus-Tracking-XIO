<?php

class NotificationModel
{
    private $conn;

    public function __construct($conn)
    {
        $this->conn = $conn;
    }

    public function create($userId, $bookingId, $message)
    {
        $statement = mysqli_prepare($this->conn, 'INSERT INTO notifications (user_id, booking_id, message) VALUES (?, ?, ?)');
        mysqli_stmt_bind_param($statement, 'iis', $userId, $bookingId, $message);
        return mysqli_stmt_execute($statement);
    }

    public function getForPassenger($userId)
    {
        $statement = mysqli_prepare($this->conn, 'SELECT notification_id, booking_id, message, is_read, created_at FROM notifications WHERE user_id = ? ORDER BY notification_id DESC');
        mysqli_stmt_bind_param($statement, 'i', $userId);
        mysqli_stmt_execute($statement);
        return mysqli_stmt_get_result($statement);
    }

    public function markRead($notificationId, $userId)
    {
        $statement = mysqli_prepare($this->conn, 'UPDATE notifications SET is_read = 1 WHERE notification_id = ? AND user_id = ?');
        mysqli_stmt_bind_param($statement, 'ii', $notificationId, $userId);
        return mysqli_stmt_execute($statement);
    }

    public function unreadCount($userId)
    {
        $statement = mysqli_prepare($this->conn, 'SELECT COUNT(*) AS total FROM notifications WHERE user_id = ? AND is_read = 0');
        mysqli_stmt_bind_param($statement, 'i', $userId);
        mysqli_stmt_execute($statement);
        return (int) (mysqli_fetch_assoc(mysqli_stmt_get_result($statement))['total'] ?? 0);
    }
}
