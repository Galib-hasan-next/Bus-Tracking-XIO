<?php

class UserModel
{
    private $conn;

    public function __construct($conn)
    {
        $this->conn = $conn;
    }

    public function getUserByEmail($email)
    {
        $email = mysqli_real_escape_string($this->conn, $email);

        $sql = "
        SELECT *
        FROM users
        WHERE email='$email'
        LIMIT 1
        ";

        return mysqli_query($this->conn, $sql);
    }

    public function emailExists($email)
    {
        return mysqli_num_rows($this->getUserByEmail($email)) > 0;
    }

    public function registerPassenger($data)
    {
        $name = mysqli_real_escape_string($this->conn, $data['name']);
        $email = mysqli_real_escape_string($this->conn, $data['email']);
        $phone = mysqli_real_escape_string($this->conn, $data['phone']);
        $password = mysqli_real_escape_string($this->conn, $data['password']);
        return mysqli_query($this->conn, "INSERT INTO users (name,email,phone,password,role) VALUES ('$name','$email','$phone','$password','passenger')");
    }

    public function registerCompany($data)
    {
        $name = mysqli_real_escape_string($this->conn, $data['name']);
        $email = mysqli_real_escape_string($this->conn, $data['email']);
        $phone = mysqli_real_escape_string($this->conn, $data['phone']);
        $password = mysqli_real_escape_string($this->conn, $data['password']);
        $company = mysqli_real_escape_string($this->conn, $data['company_name']);
        $address = mysqli_real_escape_string($this->conn, $data['address']);
        if (!mysqli_query($this->conn, "INSERT INTO users (name,email,phone,password,role) VALUES ('$name','$email','$phone','$password','company')")) return false;
        $userId = mysqli_insert_id($this->conn);
        return mysqli_query($this->conn, "INSERT INTO companies (user_id,company_name,email,phone,address,status) VALUES ('$userId','$company','$email','$phone','$address','pending')");
    }
}
