<?php

require_once __DIR__ . '/../../config/database.php';
require_once __DIR__ . '/../models/AdminModel.php';

class AdminController
{
    private $adminModel;

    public function __construct()
    {
        $database = new Database();
        $this->adminModel = new AdminModel($database->connect());
    }

    private function requireAdmin()
    {
        if (!isset($_SESSION['user_id']) || ($_SESSION['role'] ?? '') !== 'admin') {
            header('Location: index.php?page=signin');
            exit();
        }
    }

    public function dashboard()
    {
        $this->requireAdmin();
        $name = $_SESSION['name'] ?? 'Admin';
        include __DIR__ . '/../views/admin/dashboard.php';
    }

    public function verifyCompanies()
    {
        $this->requireAdmin();

        if (isset($_GET['approve'])) {
            $this->adminModel->updateCompanyStatus($_GET['approve'], 'approved');
            header('Location: index.php?page=admin_verify_companies');
            exit();
        }

        if (isset($_GET['reject'])) {
            $this->adminModel->updateCompanyStatus($_GET['reject'], 'rejected');
            header('Location: index.php?page=admin_verify_companies');
            exit();
        }

        $result = $this->adminModel->getCompanies();
        include __DIR__ . '/../views/admin/verify_companies.php';
    }

    public function users()
    {
        $this->requireAdmin();
        $name = $_SESSION['name'] ?? 'Admin';
        $search = trim($_GET['search'] ?? '');
        $users = $this->adminModel->getUsers($search);
        include __DIR__ . '/../views/admin/users.php';
    }

    public function userDetails()
    {
        $this->requireAdmin();
        $name = $_SESSION['name'] ?? 'Admin';
        $userId = (int) ($_GET['user_id'] ?? 0);
        $user = mysqli_fetch_assoc($this->adminModel->getUser($userId));
        if (!$user) {
            header('Location: index.php?page=admin_users');
            exit();
        }
        include __DIR__ . '/../views/admin/user_details.php';
    }

    public function updateUserStatus()
    {
        $this->requireAdmin();
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            header('Location: index.php?page=admin_users');
            exit();
        }
        $userId = (int) ($_POST['user_id'] ?? 0);
        $status = $_POST['status'] ?? '';
        if ($userId > 0 && in_array($status, ['active', 'inactive'], true) && $userId !== (int) $_SESSION['user_id']) {
            $this->adminModel->updateUserStatus($userId, $status);
        }
        header('Location: index.php?page=admin_user_details&user_id=' . $userId);
        exit();
    }

    public function reports()
    {
        $this->requireAdmin();
        $name = $_SESSION['name'] ?? 'Admin';
        $stats = $this->adminModel->getDashboardStats();
        $bookingBreakdown = $this->adminModel->getBookingBreakdown();
        $companyStats = $this->adminModel->getCompanyStats();
        include __DIR__ . '/../views/admin/reports.php';
    }
}
