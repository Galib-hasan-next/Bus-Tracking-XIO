<?php
require_once __DIR__ . '/../../config/database.php';
require_once __DIR__ . '/../models/CompanyModel.php';
require_once __DIR__ . '/../models/BookingModel.php';

class CompanyController
{
    private $companyModel;
    private $bookingModel;

    public function __construct()
    {
        $database = new Database();
        $conn = $database->connect();

        $this->companyModel = new CompanyModel($conn);
        $this->bookingModel = new BookingModel($conn);
    }

    public function dashboard()
    {
        /* ===========================================
           CHECK COMPANY LOGIN
        =========================================== */

        if (!isset($_SESSION['user_id']) || $_SESSION['role'] != "company") {

            header("Location: index.php?page=signin");
            exit();

        }

        $user_id = $_SESSION['user_id'];
        $name = htmlspecialchars($_SESSION['name']);

        /* ===========================================
           COMPANY INFORMATION
        =========================================== */

        $company_result = $this->companyModel->getCompanyByUserId($user_id);

        if (mysqli_num_rows($company_result) == 0) {

            die("Company profile not found.");

        }

        $company = mysqli_fetch_assoc($company_result);

        $company_id = $company['company_id'];

        /* ===========================================
           TOTAL BUSES
        =========================================== */

        $result = $this->companyModel->getTotalBuses($company_id);
        $total_bus = mysqli_fetch_assoc($result)['total'];

        /* ===========================================
           ACTIVE BUSES
        =========================================== */

        $result = $this->companyModel->getActiveBuses($company_id);
        $active_bus = mysqli_fetch_assoc($result)['total'];

        /* ===========================================
           TOTAL ROUTES
        =========================================== */

        $result = $this->companyModel->getTotalRoutes($company_id);
        $total_routes = mysqli_fetch_assoc($result)['total'];

        /* ===========================================
           TOTAL BOOKINGS
        =========================================== */

        $result = $this->companyModel->getTotalBookings($company_id);
        $total_bookings = mysqli_fetch_assoc($result)['total'];

        /* ===========================================
           TICKETS SOLD
        =========================================== */

        $result = $this->companyModel->getTicketsSold($company_id);

        $row = mysqli_fetch_assoc($result);

        $tickets_sold = $row['total'] ?? 0;

        /* ===========================================
           REVENUE
        =========================================== */

        $result = $this->companyModel->getRevenue($company_id);

        $row = mysqli_fetch_assoc($result);

        $revenue = $row['total'] ?? 0;

        /* ===========================================
           RECENT DATA
        =========================================== */

        $recent_bus_result = $this->companyModel->getRecentBuses($company_id);

        $recent_route_result = $this->companyModel->getRecentRoutes($company_id);

        $recent_booking_result = $this->companyModel->getRecentBookings($company_id);

        /* ===========================================
           LOAD VIEW
        =========================================== */

        include __DIR__ . '/../views/company/dashboard.php';
    }

    private function requireCompany()
    {
        if (!isset($_SESSION['user_id']) || ($_SESSION['role'] ?? '') !== 'company') {
            header('Location: index.php?page=signin');
            exit();
        }

        $company = mysqli_fetch_assoc($this->companyModel->getCompanyByUserId((int) $_SESSION['user_id']));
        if (!$company) {
            exit('Company profile not found.');
        }
        return $company;
    }

    public function profile()
    {
        $company = $this->requireCompany();
        $name = $_SESSION['name'] ?? '';
        include __DIR__ . '/../views/company/profile.php';
    }

    public function editProfile()
    {
        $company = $this->requireCompany();
        $name = $_SESSION['name'] ?? '';
        $message = '';
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $data = [
                'company_name' => trim($_POST['company_name'] ?? ''),
                'email' => trim($_POST['email'] ?? ''),
                'phone' => trim($_POST['phone'] ?? ''),
                'address' => trim($_POST['address'] ?? ''),
            ];
            if ($this->companyModel->updateCompanyProfile($company['company_id'], $data)) {
                header('Location: index.php?page=company_profile&updated=1');
                exit();
            }
            $message = 'Profile update failed.';
            $company = array_merge($company, $data);
        }
        include __DIR__ . '/../views/company/edit_profile.php';
    }

    public function bookings()
    {
        $company = $this->requireCompany();
        $name = $_SESSION['name'] ?? '';
        $result = $this->bookingModel->getCompanyBookings($company['company_id']);
        $total_bookings = mysqli_num_rows($result);
        include __DIR__ . '/../views/company/bookings.php';
    }

    public function bookingDetails()
    {
        $company = $this->requireCompany();
        $name = $_SESSION['name'] ?? '';
        $booking_id = (int) ($_GET['booking_id'] ?? 0);
        $booking = mysqli_fetch_assoc($this->bookingModel->getCompanyBooking($booking_id, $company['company_id']));
        if (!$booking) {
            header('Location: index.php?page=company_bookings');
            exit();
        }
        include __DIR__ . '/../views/company/booking_details.php';
    }

    public function updateBookingStatus($status)
    {
        $company = $this->requireCompany();
        $booking_id = (int) ($_GET['booking_id'] ?? 0);
        if (mysqli_fetch_assoc($this->bookingModel->getCompanyBooking($booking_id, $company['company_id']))) {
            $this->bookingModel->updateStatus($booking_id, $status);
        }
        header('Location: index.php?page=company_booking_details&booking_id=' . $booking_id . '&success=1');
        exit();
    }

    public function reports()
    {
        $company = $this->requireCompany();
        $name = $_SESSION['name'] ?? '';
        $stats = [
            'total_buses' => (int) mysqli_fetch_assoc($this->companyModel->getTotalBuses($company['company_id']))['total'],
            'active_buses' => (int) mysqli_fetch_assoc($this->companyModel->getActiveBuses($company['company_id']))['total'],
            'total_routes' => (int) mysqli_fetch_assoc($this->companyModel->getTotalRoutes($company['company_id']))['total'],
            'total_bookings' => (int) mysqli_fetch_assoc($this->companyModel->getTotalBookings($company['company_id']))['total'],
            'tickets_sold' => (int) (mysqli_fetch_assoc($this->companyModel->getTicketsSold($company['company_id']))['total'] ?? 0),
            'revenue' => (float) (mysqli_fetch_assoc($this->companyModel->getRevenue($company['company_id']))['total'] ?? 0),
        ];
        $busStats = $this->companyModel->getBusReportStats($company['company_id']);
        $routeStats = $this->companyModel->getRouteReportStats($company['company_id']);
        include __DIR__ . '/../views/company/reports.php';
    }

    public function verifyPayment()
    {
        $company = $this->requireCompany();
        $name = $_SESSION['name'] ?? '';
        $message = '';
        $booking_id = (int) ($_GET['booking_id'] ?? 0);
        $action = $_GET['action'] ?? '';
        if ($booking_id > 0 && in_array($action, ['confirm','reject'], true)) {
            $booking = mysqli_fetch_assoc($this->bookingModel->getCompanyBooking($booking_id, $company['company_id']));
            if ($booking && $booking['payment_status'] === 'Submitted') {
                $status = $action === 'confirm' ? 'Verified' : 'Rejected';
                $bookingStatus = $action === 'confirm' ? 'Confirmed' : 'Booked';
                if ($this->bookingModel->verifyPayment($booking_id, $company['company_id'], $status)) {
                    $message = $action === 'confirm' ? 'Payment confirmed successfully.' : 'Payment rejected.';
                } else {
                    $message = 'Unable to update payment.';
                }
            } else {
                $message = 'This payment cannot be updated.';
            }
        }

        $result = $this->bookingModel->getPaymentsForVerification($company['company_id']);
        include __DIR__ . '/../views/company/payment_verification.php';
    }
}
